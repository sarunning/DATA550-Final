select(Diabetes_012, BMI, HighBP,
PhysActivity, Sex, Age
) %>%
tbl_summary(
by = Diabetes_012,
label = list(
BMI ~ "Body Mass Index",
HighBP ~ "High Blood Pressure",
PhysActivity ~ "Physical Activity",
Sex ~ "Sex",
Age ~ "Age Group"),
statistic = list(
all_continuous() ~ "{mean} ({sd})",
all_categorical() ~ "{n} ({p}%)")
) %>%
modify_header(label = "**Characteristic**") %>%
modify_caption("**Table 1. Characteristics of respondents by diabetes status**")
library(ggplot2)
ggplot(diabetes, aes(group = Diabetes_012, y = BMI)) +
geom_boxplot() +
labs(
x = "Diabetes Status",
y = "BMI",
title = "BMI by Diabetes Status"
) +
theme_minimal()
